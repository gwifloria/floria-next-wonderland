{
  "hooks": {
    "permissions": {
      "defaultMode": "plan"
    },
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'hi'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'end'"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "notify-send 'Claude Code' 'Awaiting your input'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'prompt received'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'session start'"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "bash",
        "hooks": [
          {
            "type": "command",
            "command": "yarn typecheck && yarn lint"
          }
        ]
      }
    ]
  }
}